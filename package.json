{
  "name": "on-ta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "predev": "npm run sync-data",
    "dev": "vite",
    "prebuild": "npm run sync-data",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:build": "node database/build.mjs",
    "db:audio": "node database/tts/generate-audio.mjs",
    "check-site": "node scripts/check-site.mjs",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "deploy:rollback": "node scripts/deploy.mjs rollback"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}

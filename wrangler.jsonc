// Cloudflare Workers deployment (Workers Builds runs `npm run build` then
// `npx wrangler deploy`). The name must match the Worker in the dashboard.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "english-project",
  "main": "worker/index.js",
  // Must not be newer than the workerd bundled with the pinned wrangler.
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Real 404s (dist/404.html). The app uses HashRouter, so it never needs
    // the single-page-application fallback.
    "not_found_handling": "404-page",
    // Only audio goes through the Worker (Range support for seeking);
    // everything else is served straight from the asset store.
    "run_worker_first": ["/data/audio/*"]
  },
  "observability": {
    "enabled": true
  },
  // Non-main branches are built with `npx wrangler preview`, which needs this
  // block (may stay empty). Each branch gets <branch>-english-project...workers.dev
  // and serves as staging before merging to main.
  "previews": {},
  // Staging: `wrangler deploy --env staging` deploys a separate Worker,
  // english-project-staging (https://english-project-staging.<subdomain>.workers.dev).
  // Inherited from the top level by wrangler 4.159.0: main, compatibility_date,
  // assets (incl. run_worker_first), observability, previews, workers_dev.
  // NOT inherited (must be repeated here if added above): vars, define, secrets
  // and every binding (kv_namespaces, d1_databases, r2_buckets, services...).
  // The name would default to "<name>-staging" anyway; it is spelled out so a
  // rename of the top-level Worker can never retarget staging by accident.
  "env": {
    "staging": {
      "name": "english-project-staging"
    }
  }
}
